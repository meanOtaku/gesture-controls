<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/gc_ink</item>
        <item name="colorPrimaryDark">@color/gc_bg</item>
        <item name="colorAccent">@color/gc_yellow</item>
        <item name="android:colorBackground">@color/gc_bg</item>
        <item name="android:windowBackground">@color/gc_bg</item>
        <item name="android:textColorPrimary">@color/gc_ink</item>
        <item name="android:textColorSecondary">@color/gc_ink_2</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Condensed uppercase label: section headings and small captions. -->
    <style name="Gc.Label" parent="">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/gc_ink_3</item>
        <item name="android:textSize">10sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Gc.Body" parent="">
        <item name="android:textColor">@color/gc_ink_2</item>
        <item name="android:textSize">11sp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Flat, square buttons like the desktop's: primary is ink on blue, secondary is an outline. -->
    <style name="Gc.Button" parent="">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/gc_blue</item>
        <item name="android:background">@drawable/gc_button_primary</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Gc.Button.Outline">
        <item name="android:textColor">@color/gc_button_outline_text</item>
        <item name="android:background">@drawable/gc_button_outline</item>
    </style>

    <style name="Gc.Button.Attention">
        <item name="android:background">@drawable/gc_button_attention</item>
    </style>

    <!-- Transport selector: two square segments, the chosen one filled. -->
    <style name="Gc.Segment" parent="">
        <item name="android:button">@null</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/gc_segment_text</item>
        <item name="android:background">@drawable/gc_segment</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
</resources>
