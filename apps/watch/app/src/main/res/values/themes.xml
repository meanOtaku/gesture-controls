<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Electric, the desktop's original deep-blue look, and the base the other two override. The desktop names the
         theme (desktop.set_theme); WatchTheme picks the style. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">?attr/gcInk</item>
        <item name="colorPrimaryDark">?attr/gcBg</item>
        <item name="colorAccent">?attr/gcAttentionFill</item>
        <item name="android:colorBackground">?attr/gcBg</item>
        <item name="android:windowBackground">?attr/gcBg</item>
        <item name="android:textColorPrimary">?attr/gcInk</item>
        <item name="android:textColorSecondary">?attr/gcInk2</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="gcBg">@color/gc_bg</item>
        <item name="gcPanel">@color/gc_panel</item>
        <item name="gcInk">@color/gc_ink</item>
        <item name="gcInk2">@color/gc_ink_2</item>
        <item name="gcInk3">@color/gc_ink_3</item>
        <item name="gcLine">@color/gc_line</item>
        <item name="gcWash">@color/gc_wash</item>
        <item name="gcPrimary">@color/gc_ink</item>
        <item name="gcOnPrimary">@color/gc_blue</item>
        <item name="gcPrimaryPressed">#CCF2F2F2</item>
        <item name="gcAttentionFill">@color/gc_yellow</item>
        <item name="gcAttentionPressed">#CCF2F200</item>
        <item name="gcOk">@color/gc_green</item>
        <item name="gcAttention">@color/gc_yellow</item>
        <item name="gcBad">@color/gc_red</item>
        <item name="gcStroke">1dp</item>
    </style>

    <!-- Neo-brutalism: cream paper, black ink, thick outlines, a pink primary. Status words are darkened to read on cream. -->
    <style name="AppTheme.Neo">
        <item name="gcBg">#FBF3E4</item>
        <item name="gcPanel">#FFFDF8</item>
        <item name="gcInk">#17130E</item>
        <item name="gcInk2">#DB17130E</item>
        <item name="gcInk3">#AD17130E</item>
        <item name="gcLine">#17130E</item>
        <item name="gcWash">#1A17130E</item>
        <item name="gcPrimary">#FF6F91</item>
        <item name="gcOnPrimary">#17130E</item>
        <item name="gcPrimaryPressed">#CCFF6F91</item>
        <item name="gcAttentionFill">#FFD23F</item>
        <item name="gcAttentionPressed">#CCFFD23F</item>
        <item name="gcOk">#0F7A63</item>
        <item name="gcAttention">#A85A00</item>
        <item name="gcBad">#C21F45</item>
        <item name="gcStroke">2dp</item>
    </style>

    <!-- NERV: black panels, orange frames, green for normal state, amber for waiting, red for failure. -->
    <style name="AppTheme.Nerv">
        <item name="gcBg">#000000</item>
        <item name="gcPanel">#0A0A0A</item>
        <item name="gcInk">#E8E8E0</item>
        <item name="gcInk2">#E6E8E8E0</item>
        <item name="gcInk3">#9A9A94</item>
        <item name="gcLine">#B3FF9900</item>
        <item name="gcWash">#2650FF50</item>
        <item name="gcPrimary">#FF9900</item>
        <item name="gcOnPrimary">#000000</item>
        <item name="gcPrimaryPressed">#CCFF9900</item>
        <item name="gcAttentionFill">#FFCC00</item>
        <item name="gcAttentionPressed">#CCFFCC00</item>
        <item name="gcOk">#50FF50</item>
        <item name="gcAttention">#FFCC00</item>
        <item name="gcBad">#FF3030</item>
        <item name="gcStroke">1dp</item>
    </style>

    <!-- Condensed uppercase label: section headings and small captions. -->
    <style name="Gc.Label" parent="">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">?attr/gcInk3</item>
        <item name="android:textSize">10sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Gc.Body" parent="">
        <item name="android:textColor">?attr/gcInk2</item>
        <item name="android:textSize">11sp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Flat, square buttons like the desktop's: primary is ink on blue, secondary is an outline. -->
    <style name="Gc.Button" parent="">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/gcOnPrimary</item>
        <item name="android:background">@drawable/gc_button_primary</item>
        <item name="android:minHeight">@dimen/gc_touch_min</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Gc.Button.Outline">
        <item name="android:textColor">@color/gc_button_outline_text</item>
        <item name="android:background">@drawable/gc_button_outline</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Rare or secondary actions: no box, so they never compete with the status and the one primary action. -->
    <style name="Gc.Button.Text">
        <item name="android:textColor">@color/gc_button_text_text</item>
        <item name="android:background">@drawable/gc_button_text</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Gc.Button.Attention">
        <item name="android:background">@drawable/gc_button_attention</item>
    </style>

    <!-- Transport selector: two square segments, the chosen one filled. -->
    <style name="Gc.Segment" parent="">
        <item name="android:button">@null</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">8sp</item>
        <item name="autoSizeMaxTextSize">12sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
        <item name="android:textColor">@color/gc_segment_text</item>
        <item name="android:background">@drawable/gc_segment</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/gc_touch_min</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
</resources>
