<?xml version="1.0" encoding="utf-8"?>
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gc_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:boxedEdges="all">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:gravity="center_horizontal">

            <TextView
                style="@style/Gc.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name" />

            <!-- The one thing worth reading at a glance: is a desktop receiving? Coloured in code. -->
            <TextView
                android:id="@+id/connectionStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="@string/status_disconnected"
                android:textAllCaps="true"
                android:textColor="@color/gc_ink"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/discoveryStatusText"
                style="@style/Gc.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/discovery_searching" />

            <TextView
                android:id="@+id/discoveryHistoryText"
                style="@style/Gc.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/gc_ink_3"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/endpointSourceText"
                style="@style/Gc.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/linkDiagnosticsText"
                style="@style/Gc.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/gc_red"
                android:textSize="10sp" />

            <Button
                android:id="@+id/trustButton"
                style="@style/Gc.Button.Attention"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_trust"
                android:visibility="gone" />

            <Button
                android:id="@+id/connectButton"
                style="@style/Gc.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_connect" />

            <TextView
                style="@style/Gc.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/transport_heading" />

            <RadioGroup
                android:id="@+id/transportGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/transportBluetoothButton"
                    style="@style/Gc.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/transport_bluetooth" />

                <RadioButton
                    android:id="@+id/transportWifiButton"
                    style="@style/Gc.Segment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/transport_wifi" />
            </RadioGroup>

            <TextView
                android:id="@+id/sensorStatusText"
                style="@style/Gc.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/sensors_idle"
                android:textColor="@color/gc_ink_2" />

            <TextView
                android:id="@+id/detailText"
                style="@style/Gc.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/gc_ink_3"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/ppgStatusText"
                style="@style/Gc.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ppg_idle"
                android:textColor="@color/gc_ink_2"
                android:textSize="10sp" />

            <TextView
                style="@style/Gc.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/on_demand_heading" />

            <Button
                android:id="@+id/spo2Button"
                style="@style/Gc.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="SpO2" />

            <Button
                android:id="@+id/ecgButton"
                style="@style/Gc.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ECG" />

            <Button
                android:id="@+id/biaButton"
                style="@style/Gc.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="BIA" />

            <Button
                android:id="@+id/sweatLossButton"
                style="@style/Gc.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sweat loss" />

        </LinearLayout>
    </ScrollView>
</androidx.wear.widget.BoxInsetLayout>
