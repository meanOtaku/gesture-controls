{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "desktop-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@spatial-gesture/desktop"
      ],
      "port": 1420
    },
    {
      "name": "desktop-dist",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "exec",
        "--workspace",
        "@spatial-gesture/desktop",
        "--",
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
